[Unit]
Description=ProjectHub
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/projecthub
Environment=PORT=3000
Environment=HOST=127.0.0.1
# Environment=ADMIN_PASSWORD=смените-меня   # нужен только при самом первом запуске
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
